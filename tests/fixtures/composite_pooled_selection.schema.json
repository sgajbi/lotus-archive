{
  "additionalProperties": false,
  "description": "Read an exact final result; neither submission nor caller economics.",
  "properties": {
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "composite_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Composite Id",
      "type": "string"
    },
    "calculation_id": {
      "format": "uuid",
      "title": "Calculation Id",
      "type": "string"
    },
    "schema_version": {
      "const": "composite-pooled-mwr.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "metric_id": {
      "const": "POOLED_MONEY_WEIGHTED_RETURN",
      "title": "Metric Id",
      "type": "string"
    },
    "method": {
      "const": "XIRR:v1",
      "title": "Method",
      "type": "string"
    },
    "period_start": {
      "format": "date",
      "title": "Period Start",
      "type": "string"
    },
    "period_end": {
      "format": "date",
      "title": "Period End",
      "type": "string"
    },
    "reporting_currency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Reporting Currency",
      "type": "string"
    },
    "return_view": {
      "enum": [
        "GROSS",
        "NET_ACTUAL",
        "NET_MODEL_FEE"
      ],
      "title": "Return View",
      "type": "string"
    },
    "fee_basis": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Fee Basis",
      "type": "string"
    },
    "policy_binding_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Policy Binding Id",
      "type": "string"
    },
    "policy_content_hash": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Policy Content Hash",
      "type": "string"
    },
    "day_count_basis": {
      "enum": [
        "BUS/252",
        "ACT/365",
        "ACT/ACT"
      ],
      "title": "Day Count Basis",
      "type": "string"
    },
    "fallback_policy": {
      "enum": [
        "REQUIRE_XIRR",
        "ALLOW_MODIFIED_DIETZ"
      ],
      "title": "Fallback Policy",
      "type": "string"
    },
    "engine_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Engine Version",
      "type": "string"
    },
    "source_manifest_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Source Manifest Id",
      "type": "string"
    },
    "input_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Manifest Digest",
      "type": "string"
    },
    "source_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Bundle Digest",
      "type": "string"
    },
    "response_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Response Digest",
      "type": "string"
    },
    "expected_portfolio_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Expected Portfolio Ids",
      "type": "array"
    },
    "source_pins": {
      "items": {
        "$ref": "#/$defs/PooledSourcePin"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Source Pins",
      "type": "array"
    },
    "correction_of_calculation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Correction Of Calculation Id"
    },
    "predecessor_response_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Predecessor Response Digest"
    }
  },
  "required": [
    "tenant_id",
    "composite_id",
    "calculation_id",
    "schema_version",
    "metric_id",
    "method",
    "period_start",
    "period_end",
    "reporting_currency",
    "return_view",
    "fee_basis",
    "policy_binding_id",
    "policy_content_hash",
    "day_count_basis",
    "fallback_policy",
    "engine_version",
    "source_manifest_id",
    "input_manifest_digest",
    "source_bundle_digest",
    "response_digest",
    "expected_portfolio_ids",
    "source_pins",
    "correction_of_calculation_id",
    "predecessor_response_digest"
  ],
  "title": "PooledAnalysisSelection",
  "type": "object",
  "$defs": {
    "PooledSourcePin": {
      "additionalProperties": false,
      "description": "Exact retained owner source vector, distinct from read authority.",
      "properties": {
        "pin_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Pin Id",
          "type": "string"
        },
        "owner": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Owner",
          "type": "string"
        },
        "product_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Product Name",
          "type": "string"
        },
        "product_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Product Version",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Revision",
          "type": "string"
        },
        "source_cut_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Source Cut Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        },
        "compatibility_group": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Compatibility Group",
          "type": "string"
        },
        "coverage_from": {
          "format": "date",
          "title": "Coverage From",
          "type": "string"
        },
        "coverage_to": {
          "format": "date",
          "title": "Coverage To",
          "type": "string"
        },
        "completeness": {
          "const": "COMPLETE",
          "title": "Completeness",
          "type": "string"
        },
        "page_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Page Ids",
          "type": "array"
        },
        "expected_page_count": {
          "minimum": 1,
          "title": "Expected Page Count",
          "type": "integer"
        }
      },
      "required": [
        "pin_id",
        "owner",
        "product_name",
        "product_version",
        "revision",
        "source_cut_id",
        "payload_digest",
        "compatibility_group",
        "coverage_from",
        "coverage_to",
        "completeness",
        "page_ids",
        "expected_page_count"
      ],
      "title": "PooledSourcePin",
      "type": "object"
    }
  }
}
